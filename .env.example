# Copie para .env.local e preencha com os valores do painel Supabase (Project Settings > API).
# Nunca commite .env.local.
#
# CRA embute qualquer REACT_APP_* no JavaScript do browser (visível em Sources).
# Use só URL + anon/publishable key (públicas por desenho). NUNCA service_role com REACT_APP_.

REACT_APP_SUPABASE_URL=
REACT_APP_SUPABASE_ANON_KEY=

# Opcional. Se vazio, usa origem atual + /redefinir-senha
# REACT_APP_PASSWORD_RESET_REDIRECT_URL=
